# Copy to .env and fill in. See README "Configure your groups".
# Comma-separated WhatsApp group JIDs to watch, e.g. 120363012345678901@g.us,120363098765432109@g.us
SOURCE_GROUP_IDS=
# JID of the group matched jobs are forwarded to (needed when OUTPUTS includes whatsapp)
TARGET_GROUP_ID=
# Record/forward postings with a score at or above this (0-100)
MATCH_THRESHOLD=70

# Where matches go (comma-separated): whatsapp, file, telegram, email. Unknown names are logged and ignored.
# A destination with missing config below is logged as a warning at startup and skipped.
OUTPUTS=whatsapp
# Folder for the `file` output (matches.jsonl + matches.md). Default: <DATA_DIR>/outputs
# OUTPUT_DIR=

# --- telegram output (OUTPUTS=telegram) -------------------------------------
# Token from @BotFather; chat id of the chat/group the bot posts to (see README "Telegram")
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- email output (OUTPUTS=email) -------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=          # Gmail: an app password, not your account password
# EMAIL_FROM=you@gmail.com
# EMAIL_TO=you@gmail.com  # comma-separated for several recipients
# SMTP_STARTTLS=1         # on by default; set 0 only for a local relay without TLS

# Max wait (ms) for one posting analysis before it is skipped
ANALYZE_TIMEOUT_MS=180000

# Language of the match reason and summary
OUTPUT_LANGUAGE=English

# Folder holding your profile (cv.pdf / job_description.md). Docker mounts ./data at /data.
# DATA_DIR=./data

# --- LLM provider -----------------------------------------------------------
# "ollama" (default, local) or "openai" (any OpenAI-compatible API)
LLM_PROVIDER=ollama
# Ollama default: http://host.docker.internal:11434 (OLLAMA_URL still works)
# LLM_BASE_URL=
LLM_MODEL=gemma4:e2b
# LLM_API_KEY=
# Ollama only: context window per request
# LLM_NUM_CTX=16384
# Per-request timeout in seconds (keep below ANALYZE_TIMEOUT_MS / 1000)
# LLM_TIMEOUT_S=170

# Example blocks for LLM_PROVIDER=openai (only Ollama is tested):
# OpenAI:     LLM_BASE_URL=https://api.openai.com/v1                                   LLM_MODEL=gpt-4o-mini
# Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/    LLM_MODEL=gemini-2.0-flash
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1                              LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1                                LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# LM Studio:  LLM_BASE_URL=http://host.docker.internal:1234/v1                         LLM_MODEL=<loaded model>
# Anthropic:  LLM_BASE_URL=https://api.anthropic.com/v1/                               LLM_MODEL=<claude model id>
